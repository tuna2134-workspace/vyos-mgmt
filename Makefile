SHELL := /bin/bash
.DEFAULT_GOAL := help

.PHONY: help install dev-backend dev-frontend migrate revision admin test lint format \
	build-frontend build up down logs ps clean

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-18s\033[0m %s\n", $$1, $$2}'

install: ## Install backend + frontend dependencies
	uv sync --all-groups
	pnpm --dir frontend install

dev-backend: ## Run FastAPI with reload on :8000
	uv run uvicorn vyos_mgmt.main:app --reload --host 0.0.0.0 --port 8000

dev-frontend: ## Run Next.js dev server on :3000
	pnpm --dir frontend dev

migrate: ## Apply database migrations
	uv run alembic upgrade head

revision: ## Create an autogenerated migration, e.g. make revision m="add x"
	uv run alembic revision --autogenerate -m "$(m)"

admin: ## Create an admin user (prompts for password)
	uv run vyos-mgmt create-admin --username "$${USERNAME:-admin}"

test: ## Run backend tests
	uv run pytest -q

lint: ## Ruff + TypeScript typecheck
	uv run ruff check src tests
	pnpm --dir frontend exec tsc --noEmit

format: ## Format backend code
	uv run ruff format src tests
	uv run ruff check --fix src tests

build-frontend: ## Static-export the frontend to frontend/out
	pnpm --dir frontend build

build: build-frontend ## Build container images
	docker compose build

up: ## Start the full stack with Docker Compose
	docker compose up -d --build

down: ## Stop the stack (keeps the database volume)
	docker compose down

logs: ## Tail stack logs
	docker compose logs -f --tail=200

ps: ## Show stack status
	docker compose ps

clean: ## Remove Python/Next build artefacts (keeps node_modules)
	rm -rf .pytest_cache .ruff_cache htmlcov .coverage frontend/.next frontend/out
