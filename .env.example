# Local development environment for the backend.
# Copy to .env and adjust. Every variable is optional except in production.
# See src/vyos_mgmt/config.py for the authoritative list.

# --- Application -------------------------------------------------------
APP_NAME="VyOS Management"
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
ENABLE_DOCS=true

# --- Security ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=vyos_mgmt_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
JWT_ISSUER=vyos-mgmt
JWT_AUDIENCE=vyos-mgmt-api
JWT_ALGORITHM=HS256

# --- Database ----------------------------------------------------------
# Local docker-compose dev DB (host port 55432) or your own PostgreSQL.
DATABASE_URL=postgresql+asyncpg://vyos:vyos@localhost:55432/vyos_mgmt
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- CORS (comma separated, explicit origins only) --------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting -----------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
TRUSTED_PROXY_HEADERS=false

# --- Optional first-run admin -----------------------------------------
# Only used when the users table is empty at startup. Prefer
# `uv run vyos-mgmt create-admin` outside of ephemeral/demo deployments.
# `create-admin` also accepts --password or VYOS_MGMT_ADMIN_PASSWORD.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# --- VyOS --------------------------------------------------------------
VYOS_TIMEOUT_SECONDS=10
VYOS_POLL_INTERVAL_SECONDS=15

# --- Frontend ----------------------------------------------------------
# Serve the static Next.js export from FastAPI when frontend/out exists.
SERVE_FRONTEND=true
# FRONTEND_DIR=/absolute/path/to/frontend/out

# --- Docker Compose only ----------------------------------------------
# These are consumed by docker-compose.yml, not by the application. The
# compose file overrides DATABASE_URL to point at the `db` service.
# POSTGRES_DB=vyos_mgmt
# POSTGRES_USER=vyos
# POSTGRES_PASSWORD=replace-with-a-strong-database-password
# APP_PORT=8000
#
# Behind TLS, also set:
# ENVIRONMENT=production
# COOKIE_SECURE=true
# TRUSTED_PROXY_HEADERS=true
# CORS_ORIGINS=https://vyos.example.com

